# Mapbox GL JS public token (exposed to the browser, must have URL restrictions)
# Get one at: https://account.mapbox.com/access-tokens/
NEXT_PUBLIC_MAPBOX_TOKEN=

# Supabase (Project -> Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only: bypasses Row Level Security. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Gemini (server-only, usado por el scraper para generar resumenes IA)
# Free tier: 15 RPM / 1500 RPD. Get one at: https://aistudio.google.com/
GEMINI_API_KEY=
